APP_NAME="Info Loker UMKM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Untuk produksi: APP_ENV=production, APP_DEBUG=false (jangan pernah true).

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default memakai SQLite supaya proyek bisa langsung dijalankan tanpa server DB.
# Untuk MySQL, ganti DB_CONNECTION=mysql dan isi DB_HOST/DB_DATABASE/DB_USERNAME/DB_PASSWORD.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/ke/database/database.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@lokerumkm.test"
MAIL_FROM_NAME="${APP_NAME}"

# OTP login via WhatsApp (Fonnte). Bila kosong, kode hanya dicatat di log
# pada environment local/testing; di produksi OTP tidak dikirim.
FONNTE_TOKEN=
FONNTE_URL=https://api.fonnte.com/send

# Seeder produksi: php artisan db:seed --class=ProductionSeeder
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Super Admin"

VITE_APP_NAME="${APP_NAME}"

# Info rekening premium (kosongkan untuk menampilkan "hubungi admin")
PREMIUM_PRICE=50000
PREMIUM_BANK_INFO=
